#!/bin/sh
# wzltest -- compile and run every test in tests/, and say what passed.
#
#   ./wzltest              all of them
#   ./wzltest store        only those whose name contains "store"
#   ./wzltest claim stats  several, each a name filter of its own
#
# tests/_*.wz are shared includes, not tests, and are skipped.
#
# Every test is a Wantzel program that exits 0 when it passes. No framework and no
# runner to configure: a test is a program, and the compiler is the first thing that
# judges it -- a test that does not compile is a failing test.
set -e
here=$(cd "$(dirname "$0")" && pwd)

if [ -z "$WANTZEL" ]; then
  for c in "$here/../../wantzel/bin/wantzel" "$here/../wantzel/bin/wantzel" "$(command -v wantzel || true)"; do
    if [ -n "$c" ] && [ -x "$c" ]; then WANTZEL="$c"; break; fi
  done
fi
[ -x "$WANTZEL" ] || { echo "wzltest: no wantzel compiler found (set WANTZEL)" >&2; exit 2; }

# See wzlrun: the version these tests were written against.
WANTZEL_TESTED=0.2.1
have=$("$WANTZEL" --version 2>/dev/null | awk '{print $2}')
if [ -n "$have" ] && [ "$have" != "$WANTZEL_TESTED" ]; then
  echo "note: tests written against Wantzel $WANTZEL_TESTED, you have $have" >&2
fi

# The tests drive the two binaries, so build them first. A test that silently used a
# stale build would report on code nobody is looking at.
mkdir -p "$here/bin"
"$WANTZEL" "$here/src/loglens.wz"  "$here/bin/loglens" || { echo "loglens does not compile" >&2; exit 1; }
"$WANTZEL" "$here/tools/genlog.wz" "$here/bin/genlog"  || { echo "genlog does not compile" >&2; exit 1; }

tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
pass=0; fail=0; failed=''

for t in "$here"/tests/*.wz; do
  name=$(basename "$t" .wz)
  # A leading underscore means "included by tests, not a test itself" -- _helpers.wz has
  # no `program` line, so compiling it as a test would report a failure that is not one.
  case "$name" in _*) continue ;; esac
  # Every argument is a name filter, and a test runs when it matches ANY of them. One
  # argument was enough while a person typed them; a tool that asks for the tests of one
  # tool asking for the tests of one change needs several.
  if [ $# -gt 0 ]; then
    hit=0
    for want in "$@"; do
      case "$name" in *"$want"*) hit=1 ;; esac
    done
    [ "$hit" -eq 1 ] || continue
  fi

  if ! out=$("$WANTZEL" "$t" "$tmp/$name" 2>&1); then
    printf '  FAIL  %-28s did not compile\n' "$name"
    printf '%s\n' "$out" | sed 's/^/          /'
    fail=$((fail + 1)); failed="$failed $name"; continue
  fi

  # Each test gets its own empty directory, so one cannot see another's files, and the
  # path to bin/ -- a test drives the two binaries and must not have to guess where they
  # are relative to a temporary directory.
  rm -rf "$tmp/d-$name"; mkdir -p "$tmp/d-$name"
  if out=$(cd "$tmp" && "./$name" "$tmp/d-$name" "$here/bin" 2>&1); then
    printf '  ok    %s\n' "$name"
    pass=$((pass + 1))
  else
    printf '  FAIL  %s\n' "$name"
    printf '%s\n' "$out" | sed 's/^/          /'
    fail=$((fail + 1)); failed="$failed $name"
  fi
done

echo
echo "$pass passed, $fail failed"
[ "$fail" -eq 0 ] || { echo "failed:$failed"; exit 1; }

# A FILTER THAT MATCHES NOTHING IS A FAILURE, not a pass.
#
# "0 passed, 0 failed" and exit 0 is indistinguishable from a suite where everything
# went well, and that is how a caller asking for tests that do not exist gets told they
# are green. Found while teaching a tool to run a demo's tests: it
# handed over paths where this expects name filters, nothing matched, and the answer was
# a cheerful zero.
if [ "$pass" -eq 0 ] && [ $# -gt 0 ]; then
  echo "no test matched: $*" >&2
  exit 1
fi
