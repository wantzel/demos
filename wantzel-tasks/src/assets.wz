procedure asset.css;
begin
  http.add("/* Light and dark both on :root, so no colour exists in only one of them. */\n:root{--bg:#fbfaf8;--card:#fff;--fg:#1a1815;--muted:#6b655c;--rule:#e6e1d8;\n");
  http.add("--accent:#8a4218;--soft:#f3e9df;--drop:#f6ede3}\n@media(prefers-color-scheme:dark){:root{--bg:#15140f;--card:#1e1c18;--fg:#ecebe6;\n");
  http.add("--muted:#9d978c;--rule:#2e2b25;--accent:#e0a473;--soft:#2a211a;--drop:#251e18}}\n*{box-sizing:border-box}\n");
  http.add("body{margin:0;background:var(--bg);color:var(--fg);\nfont:16px/1.65 Inter,\"SF Pro Text\",-apple-system,BlinkMacSystemFont,\"Segoe UI Variable Text\",\n");
  http.add("\"Segoe UI\",ui-sans-serif,system-ui,sans-serif;\n-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;\n");
  http.add("letter-spacing:-.006em}\n\nheader{display:flex;align-items:center;gap:.9rem;flex-wrap:wrap;\npadding:.9rem 1.3rem;border-bottom:1px solid var(--rule)}\n");
  http.add("h1{font:600 1.05rem/1 ui-monospace,Menlo,monospace;margin:0;color:var(--accent)}\n.sub{color:var(--muted);font-size:.88rem}\n");
  http.add(".grow{flex:1}\n\n/* the toggle: two views of the same tickets */\n.seg{display:flex;border:1px solid var(--rule);border-radius:8px;overflow:hidden}\n");
  http.add(".seg button{border:0;border-radius:0;background:var(--card);padding:.4rem .85rem;\nfont-size:.9rem;font-weight:600;color:var(--muted)}\n");
  http.add(".seg button.on{background:var(--accent);color:var(--bg)}\n\ninput,select,button,textarea{font:inherit;color:inherit;background:var(--card);\n");
  http.add("border:1px solid var(--rule);border-radius:8px;padding:.45rem .65rem}\ninput:focus,select:focus,textarea:focus{outline:2px solid var(--accent);outline-offset:-1px}\n");
  http.add("button{cursor:pointer;font-weight:600}\nbutton.primary{background:var(--accent);border-color:var(--accent);color:var(--bg)}\n");
  http.add("/* On a wide screen the scroller is an ordinary row; the phone rules below turn it\n   into something that slides. */\n");
  http.add(".scroll{display:contents}\n#q{min-width:200px}\n.bar{display:flex;gap:.5rem;padding:.7rem 1.3rem;flex-wrap:wrap;align-items:center;\n");
  http.add("border-bottom:1px solid var(--rule)}\n\n/* board */\n.board{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;\n");
  http.add("padding:1.1rem 1.3rem 4rem;align-items:start}\n@media(max-width:760px){.board{grid-template-columns:1fr}}\n");
  http.add(".col{background:transparent;border-radius:10px;padding:.35rem;min-height:120px}\n.col.over{background:var(--drop);outline:2px dashed var(--accent);outline-offset:-2px}\n");
  http.add(".col h2{font:550 .82rem/1 inherit;letter-spacing:.055em;\ntext-transform:uppercase;color:var(--muted);margin:.2rem .3rem .7rem;display:flex;gap:.5rem}\n");
  http.add(".col h2 b{color:var(--accent)}\n.card{background:var(--card);border:1px solid var(--rule);border-radius:11px;\n");
  http.add("padding:.8rem .9rem;margin-bottom:.6rem;cursor:grab;user-select:none}\n.card:hover{border-color:var(--accent)}\n");
  http.add(".card.drag{opacity:.4;cursor:grabbing}\n.card .t{font-weight:550;font-size:1.02rem;line-height:1.38;margin-bottom:.5rem;\n");
  http.add("letter-spacing:-.011em}\n.meta{display:flex;gap:.4rem;flex-wrap:wrap;align-items:center;\nfont:.78rem ui-monospace,Menlo,monospace;color:var(--muted)}\n");
  http.add(".id{color:var(--accent);font-weight:600}\n.pill{border:1px solid var(--rule);border-radius:999px;padding:.08rem .5rem}\n");
  http.add(".p0{background:var(--accent);border-color:var(--accent);color:var(--bg);font-weight:600}\n.lab{background:var(--soft);border-color:var(--soft)}\n");
  http.add(".mark{color:var(--accent)}\n/* The direction badge. Muted on purpose: it should be findable at a glance without */\n");
  http.add("/* competing with the title, because you scan for it rather than read it. */\n.flow{font-weight:600;letter-spacing:.02em}\n");
  http.add(".f-h2a{color:#3f7d3f}.f-a2h{color:var(--accent)}\n.f-a2a{color:#6b6bb4}.f-h2h{color:var(--muted)}\n");
  http.add("@media(prefers-color-scheme:dark){.f-h2a{color:#7fb37f}.f-a2a{color:#9d9de0}}\n.empty{color:var(--muted);font-size:.9rem;padding:.6rem .3rem}\n");
  http.add("\n/* list */\n.list{padding:.6rem 1.3rem 4rem}\ntable{width:100%;border-collapse:collapse}\nth{text-align:left;font:600 .78rem/1 ui-sans-serif,system-ui,sans-serif;\n");
  http.add("letter-spacing:.11em;text-transform:uppercase;color:var(--muted);\npadding:.6rem .5rem;border-bottom:1px solid var(--rule)}\n");
  http.add("td{padding:.7rem .55rem;border-bottom:1px solid var(--rule);vertical-align:top}\ntr.r{cursor:pointer}tr.r:hover td{background:var(--soft)}\n");
  http.add("td.tt{font-weight:600}\n\n/* the ticket panel */\n.sheet{position:fixed;inset:0;background:rgba(0,0,0,.4);display:none;\n");
  http.add("align-items:flex-start;justify-content:center;padding:3vh 1rem;overflow:auto}\n.sheet.on{display:flex}\n");
  http.add(".panel{background:var(--bg);border:1px solid var(--rule);border-radius:12px;\nwidth:min(760px,100%);padding:1.2rem 1.3rem 1.4rem}\n");
  http.add(".panel h3{margin:.1rem 0 1rem;font-size:1.3rem;line-height:1.3}\n.row{display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:.65rem}\n");
  http.add(".row label{display:flex;flex-direction:column;gap:.3rem;font-size:.8rem;color:var(--muted)}\n");
  http.add("textarea{width:100%;min-height:130px;resize:vertical;\nfont:14px/1.6 ui-monospace,Menlo,monospace}\n");
  http.add(".right{margin-left:auto}\nh4{font:550 .82rem/1 inherit;letter-spacing:.055em;\ntext-transform:uppercase;color:var(--accent);margin:1.3rem 0 .5rem}\n");
  http.add(".entry{border-left:2px solid var(--rule);padding:.1rem 0 .1rem .7rem;margin-bottom:.6rem}\n.who{font:.8rem ui-monospace,Menlo,monospace;color:var(--muted);margin-bottom:.25rem}\n");
  http.add(".entry p{margin:0;white-space:pre-wrap}\nul.log{margin:0;padding-left:1.2rem;font-size:.95rem}\n");
  http.add("ul.log li{margin-bottom:.25rem}\n\n/* The switch, and everything it governs. An agent entry is never hidden silently: it is\n");
  http.add("   either shown, marked as agent, or counted by something you can click. */\n.tog{border:1px solid var(--rule);border-radius:8px;padding:.4rem .8rem;\n");
  http.add("font-size:.9rem;font-weight:600;color:var(--muted);background:var(--card);cursor:pointer}\n.tog.on{background:var(--accent);border-color:var(--accent);color:var(--bg)}\n");
  http.add(".fold{border:1px dashed var(--rule);border-radius:9px;padding:.5rem .7rem;margin-bottom:.8rem;\n");
  http.add("color:var(--muted);font-size:.88rem;cursor:pointer}\n.fold:hover{border-color:var(--accent);color:var(--accent)}\n");
  http.add(".ghost{color:var(--muted);opacity:.7}\n/* An agent entry, when shown, is legible but visibly not the human register. */\n");
  http.add(".entry.ag{border-left-color:var(--accent);background:var(--soft);border-radius:0 8px 8px 0;\n");
  http.add("padding-right:.6rem}\nli.ag{color:var(--muted)}\n.tag{border:1px solid var(--accent);border-radius:999px;padding:0 .4rem;\n");
  http.add("font-size:.72rem;color:var(--accent)}\n.chk{display:flex;align-items:center;gap:.3rem;font-size:.82rem;color:var(--muted);\n");
  http.add("white-space:nowrap}\n.chk input{width:auto}\n\n/* A checkbox keeps the browser's own colours unless told otherwise, so in dark it stays\n");
  http.add("   a white square: the one control on the page that ignores the theme. */\ninput[type=checkbox]{accent-color:var(--accent);width:1rem;height:1rem;margin:0}\n");
  http.add("\n/* ---- the phone ---------------------------------------------------------------\n   Measured on a 420px screen: the header wrapped to three rows and the filter bar to\n");
  http.add("   four, so five rows of chrome stood between opening the page and seeing a ticket.\n   Everything below is about getting to the first card -- and about keeping every action\n");
  http.add("   reachable while doing it. */\n@media(max-width:620px){\n  header{gap:.45rem;padding:.6rem .8rem;flex-wrap:nowrap}\n");
  http.add("  /* The tagline explains the project to a first-time reader on a desktop; on a phone it\n     is a whole row spent on something the reader is not there for. */\n");
  http.add("  header .sub:last-of-type{display:none}\n  .grow{display:none}\n  h1{font-size:.92rem;flex:0 0 auto}\n");
  http.add("  #count{display:none}\n  .seg,.tog{flex:0 0 auto}\n  .tog{padding:.4rem .6rem}\n  header button{font-size:.85rem;padding:.38rem .62rem}\n");
  http.add("\n  /* One row that scrolls sideways beats four rows that wrap. \"New ticket\" is pinned\n     outside that scroller: an action you cannot reach is an action you do not have. */\n");
  http.add("  .bar{flex-wrap:nowrap;padding:.55rem .8rem;gap:.45rem;align-items:center}\n  .scroll{display:flex;gap:.45rem;overflow-x:auto;-webkit-overflow-scrolling:touch;\n");
  http.add("          scrollbar-width:none;flex:1 1 auto;min-width:0}\n  .scroll::-webkit-scrollbar{display:none}\n");
  http.add("  .scroll>*{flex:0 0 auto}\n  #q{min-width:8rem;flex:1 0 8rem}\n  .bar select{max-width:8.5rem}\n");
  http.add("  #new{flex:0 0 auto;padding:.45rem .7rem;font-size:.85rem}\n\n  /* A column heading at 1rem-plus reads as a page title and competes with the cards. */\n");
  http.add("  .col h2{font-size:.72rem;letter-spacing:.07em}\n  .col{padding:.2rem}\n  .board{gap:.4rem;padding:.55rem .8rem}\n");
  http.add("  .card{padding:.7rem .8rem;margin-bottom:.5rem}\n  .card .t{font-size:.98rem}\n  .meta{font-size:.74rem}\n");
  http.add("\n  /* A sheet from the bottom is the phone idiom, and it keeps the top of the ticket\n     (its title) against the thumb rather than under the notch. */\n");
  http.add("  .panel{border-radius:14px 14px 0 0;padding:1rem .85rem 1.3rem;\n         width:100%;max-height:92vh}\n");
  http.add("  .row{gap:.5rem}\n  .row label{flex:1 1 7rem}\n  table{font-size:.86rem}\n}\n");
end;

procedure asset.html;
begin
  http.add("<header><h1>wantzel-tasks</h1>\n<span class=\"sub\" id=\"count\"></span>\n<span class=\"seg\"><button id=\"vb\" class=\"on\" onclick=\"setview('board')\">Board</button>\n");
  http.add("<button id=\"vl\" onclick=\"setview('list')\">List</button></span>\n<button id=\"ag\" class=\"tog\" onclick=\"setagent(!showagent)\" title=\"show or fold the entries written for agents\">Clean</button>\n");
  http.add("<span class=\"grow\"></span>\n<span class=\"sub\">one binary &middot; MCP, REST and this page on one port</span>\n");
  http.add("</header>\n\n<div class=\"bar\">\n<!-- The filters sit in their own scroller so that on a phone they slide sideways on one\n");
  http.add("     row instead of wrapping onto four. New ticket stays outside it, always reachable. -->\n<div class=\"scroll\">\n");
  http.add("<input id=\"q\" placeholder=\"search\">\n<select id=\"fm\"><option value=\"\">every milestone</option></select>\n");
  http.add("<select id=\"fa\"><option value=\"\">every area</option></select>\n<select id=\"fp\"><option value=\"\">every priority</option>\n");
  http.add("<option>P0</option><option>P1</option><option>P2</option><option>P3</option></select>\n<select id=\"ff\"><option value=\"\">every direction</option>\n");
  http.add("<option value=\"h2a\">human to agent</option><option value=\"a2h\">agent needs a human</option>\n");
  http.add("<option value=\"a2a\">agent to agent</option><option value=\"h2h\">human to human</option></select>\n");
  http.add("<select id=\"fk\"><option value=\"\">every kind</option><option>bug</option>\n<option>gap</option><option>chore</option><option>research</option><option>doc</option></select>\n");
  http.add("</div>\n<button id=\"new\" class=\"primary right\" onclick=\"open_(null)\">New ticket</button>\n</div>\n");
  http.add("\n<div class=\"board\" id=\"board\"></div>\n<div class=\"list\" id=\"list\" style=\"display:none\"></div>\n");
  http.add("\n<!-- the panel: fields, then the record, then the conversation -->\n<div class=\"sheet\" id=\"sheet\" onclick=\"if(event.target===this)close_()\">\n");
  http.add("<div class=\"panel\">\n<h3 id=\"ptitle\">New ticket</h3>\n<div class=\"row\"><label style=\"flex:1\">title<input id=\"f_title\" style=\"width:100%\"></label></div>\n");
  http.add("<div class=\"row\">\n<label>status<select id=\"f_status\"><option>todo</option><option>doing</option>\n");
  http.add("<option>done</option></select></label>\n<label>priority<select id=\"f_priority\"><option>P0</option><option>P1</option>\n");
  http.add("<option selected>P2</option><option>P3</option></select></label>\n<label>kind<select id=\"f_kind\"><option value=\"\">--</option><option>bug</option>\n");
  http.add("<option>gap</option><option>chore</option><option>research</option><option>doc</option></select></label>\n");
  http.add("<label>area<input id=\"f_area\" size=\"9\" placeholder=\"general\"></label>\n<label>flow<select id=\"f_flow\"><option value=\"\">--</option>\n");
  http.add("<option value=\"h2a\">h2a &middot; human to agent</option>\n<option value=\"a2h\">a2h &middot; agent needs a human</option>\n");
  http.add("<option value=\"a2a\">a2a &middot; agent to agent</option>\n<option value=\"h2h\">h2h &middot; human to human</option></select></label>\n");
  http.add("<label>milestone<input id=\"f_milestone\" size=\"9\"></label>\n<label>assignee<input id=\"f_assignee\" size=\"9\"></label>\n");
  http.add("</div>\n<div class=\"row\"><label style=\"flex:1\">labels, comma separated\n<input id=\"f_labels\" style=\"width:100%\"></label></div>\n");
  http.add("<textarea id=\"f_body\" placeholder=\"What, why, and what done looks like.\"></textarea>\n<div class=\"row\" style=\"margin-top:.8rem\">\n");
  http.add("<button class=\"primary\" onclick=\"save()\">Save</button>\n<button onclick=\"close_()\">Cancel</button>\n");
  http.add("<button class=\"right\" id=\"del\" onclick=\"del()\">Delete</button></div>\n\n<div id=\"extra\"></div>\n");
  http.add("</div></div>\n");
end;

procedure asset.js;
begin
  http.add("const STATUS=['todo','doing','done'];\n// The arrow IS the meaning: a person to an agent, an agent back to a person, one\n");
  http.add("// agent to another. Reading \"H>A\" tells you the direction without a legend.\nconst FLOW={h2a:'H&rarr;A',a2h:'A&rarr;H',a2a:'A&rarr;A',h2h:'H&rarr;H'};\n");
  http.add("let all=[],cur=null,view='board';\n// The clean/everything switch. Remembered, because someone who wants clean tickets wants\n");
  http.add("// them tomorrow too -- a setting you have to make every morning is a setting you turn off.\n");
  http.add("let showagent=localStorage.getItem('showagent')==='1';\nconst $=i=>document.getElementById(i);\n");
  http.add("const esc=s=>(s||'').replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]));\n");
  http.add("\n// One door for everything, the same one an agent uses.\nasync function api(tool,args){\nconst r=await fetch('/api/'+tool,{method:'POST',\n");
  http.add("headers:{'Content-Type':'application/json'},body:JSON.stringify(args||{})});\nconst j=await r.json();\n");
  http.add("if(j.detail){alert(j.detail);throw new Error(j.detail)}return j}\n\n// One fetch, then filter in the page: at this size that is instant, and typing in the\n");
  http.add("// search box does not hit the server on every keystroke.\nasync function load(){\nconst j=await api('list_tickets',{limit:200});\n");
  http.add("all=j.tickets;\n$('count').textContent=j.matched+' tickets'+(j.truncated?' (showing '+j.returned+')':'');\n");
  http.add("fill('fm','milestone');fill('fa','area');draw()}\n\nfunction fill(id,f){const s=$(id),k=s.value;\n");
  http.add("const v=[...new Set(all.map(t=>t[f]).filter(Boolean))].sort();\ns.length=1;for(const x of v){const o=document.createElement('option');o.textContent=x;s.appendChild(o)}\n");
  http.add("s.value=k}\n\nfunction match(t){const q=$('q').value.toLowerCase();\nif(q){const hay=(t.title+' '+(t.body||'')+' '+(t.assignee||'')+' '+(t.milestone||'')\n");
  http.add("+' '+(t.labels||[]).join(' ')+' '+t.id).toLowerCase();\nif(!hay.includes(q))return false}\nif($('fm').value&&t.milestone!==$('fm').value)return false;\n");
  http.add("if($('fa').value&&t.area!==$('fa').value)return false;\nif($('fp').value&&t.priority!==$('fp').value)return false;\n");
  http.add("if($('ff').value&&t.flow!==$('ff').value)return false;\nif($('fk').value&&t.kind!==$('fk').value)return false;\n");
  http.add("return true}\n\nfunction setview(v){view=v;\n$('vb').className=v==='board'?'on':'';$('vl').className=v==='list'?'on':'';\n");
  http.add("$('board').style.display=v==='board'?'':'none';\n$('list').style.display=v==='list'?'':'none';draw()}\n");
  http.add("\nfunction draw(){view==='board'?drawBoard():drawList()}\n\n// ---- board ---------------------------------------------------------------\n");
  http.add("function drawBoard(){const b=$('board');b.innerHTML='';\nfor(const s of STATUS){const ts=all.filter(t=>t.status===s&&match(t));\n");
  http.add("const col=document.createElement('div');col.className='col';col.dataset.s=s;\ncol.innerHTML='<h2>'+s+' <b>'+ts.length+'</b></h2>';\n");
  http.add("if(!ts.length)col.innerHTML+='<div class=\"empty\">nothing here</div>';\nfor(const t of ts)col.appendChild(card(t));\n");
  http.add("col.ondragover=e=>{e.preventDefault();col.classList.add('over')};\ncol.ondragleave=()=>col.classList.remove('over');\n");
  http.add("col.ondrop=e=>{e.preventDefault();col.classList.remove('over');move(e.dataTransfer.getData('id'),s)};\n");
  http.add("b.appendChild(col)}}\n\nfunction card(t){const d=document.createElement('div');d.className='card';\n");
  http.add("d.draggable=true;d.onclick=()=>open_(t);\nd.ondragstart=e=>{e.dataTransfer.setData('id',t.id);d.classList.add('drag')};\n");
  http.add("d.ondragend=()=>d.classList.remove('drag');\nd.innerHTML='<div class=\"t\">'+esc(t.title)+'</div><div class=\"meta\">'+pills(t)+'</div>';\n");
  http.add("return d}\n\nfunction pills(t){let m='<span class=\"id\">'+t.id+'</span>';\nm+='<span class=\"pill'+(t.priority==='P0'?' p0':'')+'\">'+t.priority+'</span>';\n");
  http.add("if(t.kind)m+='<span class=\"pill\">'+esc(t.kind)+'</span>';\nm+='<span class=\"pill\">'+esc(t.area)+'</span>';\n");
  http.add("if(t.flow)m+='<span class=\"pill flow f-'+t.flow+'\">'+FLOW[t.flow]+'</span>';\nif(t.milestone)m+='<span class=\"pill mark\">'+esc(t.milestone)+'</span>';\n");
  http.add("for(const l of (t.labels||[]))m+='<span class=\"pill lab\">'+esc(l)+'</span>';\nif(t.assignee)m+='<span>@'+esc(t.assignee)+'</span>';\n");
  http.add("const nc=(t.comments||[]).filter(forme).length;\nif(nc)m+='<span>&#128172; '+nc+'</span>';\nconst nh=hidden(t);\n");
  http.add("if(nh&&!showagent)m+='<span class=\"ghost\" title=\"agent entries, hidden\">&#9673; '+nh+'</span>';\n");
  http.add("return m}\n\n// Dropping a card is update_ticket, nothing more. The card moves immediately and the\n");
  http.add("// call follows: at this speed the answer is back before you let go of the mouse, and\n// a reload afterwards keeps the page honest if the server disagreed.\n");
  http.add("async function move(id,status){\nconst t=all.find(x=>x.id===id);if(!t||t.status===status)return;\n");
  http.add("t.status=status;draw();\nawait api('update_ticket',{id:id,status:status});await load()}\n\n// ---- list ----------------------------------------------------------------\n");
  http.add("function drawList(){const ts=all.filter(match);\nlet h='<table><thead><tr><th>id</th><th>title</th><th>status</th><th>prio</th>'+\n");
  http.add("'<th>flow</th><th>kind</th><th>area</th><th>milestone</th><th>who</th></tr></thead><tbody>';\n");
  http.add("for(const t of ts){h+='<tr class=\"r\" data-id=\"'+t.id+'\">';\nh+='<td class=\"id\">'+t.id+'</td><td class=\"tt\">'+esc(t.title)+'</td>';\n");
  http.add("h+='<td>'+t.status+'</td><td>'+t.priority+'</td>';\nh+='<td class=\"flow f-'+(t.flow||'')+'\">'+(t.flow?FLOW[t.flow]:'')+'</td>';\n");
  http.add("h+='<td>'+esc(t.kind||'')+'</td>';\nh+='<td>'+esc(t.area)+'</td><td>'+esc(t.milestone||'')+'</td>';\n");
  http.add("h+='<td>'+esc(t.assignee||'')+'</td></tr>'}\nif(!ts.length)h+='<tr><td colspan=\"9\" class=\"empty\">nothing matches</td></tr>';\n");
  http.add("$('list').innerHTML=h+'</tbody></table>';\nfor(const tr of $('list').querySelectorAll('tr.r'))\n");
  http.add("tr.onclick=()=>open_(all.find(t=>t.id===tr.dataset.id))}\n\n// ---- the panel -----------------------------------------------------------\n");
  http.add("// A ticket is a place, so it gets an address: #T-0023 opens it, the back button closes\n// it, and a link to a ticket is something you can paste to a colleague -- or to an agent.\n");
  http.add("function open_(t){cur=t;\nif(t&&location.hash!=='#'+t.id)history.pushState({id:t.id},'','#'+t.id);\n");
  http.add("$('ptitle').textContent=t?t.id+'  '+t.title:'New ticket';\n$('del').style.display=t?'':'none';\n");
  http.add("$('f_title').value=t?t.title:'';\n$('f_status').value=t?t.status:'todo';\n$('f_priority').value=t?t.priority:'P2';\n");
  http.add("$('f_kind').value=t&&t.kind?t.kind:'';\n$('f_area').value=t?t.area:'';\n$('f_flow').value=t&&t.flow?t.flow:'';\n");
  http.add("$('f_milestone').value=t&&t.milestone?t.milestone:'';\n$('f_assignee').value=t&&t.assignee?t.assignee:'';\n");
  http.add("$('f_labels').value=t&&t.labels?t.labels.join(', '):'';\n$('f_body').value=t&&t.body?t.body:'';\n");
  http.add("$('extra').innerHTML=t?extra(t):'';\n$('sheet').classList.add('on');$('f_title').focus()}\n\n// The whole point of the two registers. Folding agent entries away gives you a clean\n");
  http.add("// tracker; NEVER silently -- a hidden entry is always counted, and the count is a button.\n// A clean view that could quietly drop things is a view you learn not to trust, and then\n");
  http.add("// you turn it off for good and the feature has achieved nothing.\nfunction setagent(on){\nshowagent=on;localStorage.setItem('showagent',on?'1':'0');\n");
  http.add("$('ag').classList.toggle('on',on);$('ag').textContent=on?'Everything':'Clean';\nif(cur)$('extra').innerHTML=extra(cur);\n");
  http.add("draw()}\n\nconst forme=e=>showagent||(e.audience||'human')!=='agent';\n\n// How many entries the clean view is holding back, so it can say so.\n");
  http.add("function hidden(t){\nreturn [...(t.comments||[]),...(t.worklog||[])].filter(e=>(e.audience||'human')==='agent').length}\n");
  http.add("\n// The record and the conversation, both append-only: there is no edit button, because\n// a log you can tidy up afterwards is not a log.\n");
  http.add("function extra(t){let h='';\nconst nh=hidden(t);\nif(nh&&!showagent)h+='<div class=\"fold\" onclick=\"setagent(true)\">'+nh+\n");
  http.add("' agent '+(nh===1?'entry':'entries')+' hidden &middot; show</div>';\nconst wl=(t.worklog||[]).filter(forme);\n");
  http.add("if(wl.length){h+='<h4>Work log</h4><ul class=\"log\">';\nfor(const l of wl)h+='<li'+(l.audience==='agent'?' class=\"ag\"':'')+'>'+\n");
  http.add("esc(l.at)+' &middot; '+esc(l.text)+'</li>';h+='</ul>'}\nh+='<div class=\"row\" style=\"margin-top:.7rem\">'+\n");
  http.add("'<input id=\"logtext\" placeholder=\"record what you found or decided\" style=\"flex:1\">'+\n'<label class=\"chk\"><input type=\"checkbox\" id=\"logag\"> for agents</label>'+\n");
  http.add("'<button onclick=\"addlog()\">Log</button></div>';\nh+='<h4>Comments</h4>';\nconst cs=(t.comments||[]).filter(forme);\n");
  http.add("for(const c of cs)\nh+='<div class=\"entry'+(c.audience==='agent'?' ag':'')+'\"><div class=\"who\">'+\n");
  http.add("esc(c.author)+' &middot; '+esc(c.at)+\n(c.audience==='agent'?' <span class=\"tag\">agent</span>':'')+\n");
  http.add("'</div><p>'+esc(c.text)+'</p></div>';\nif(!cs.length)h+='<div class=\"empty\">nothing said yet</div>';\n");
  http.add("h+='<div class=\"row\" style=\"margin-top:.6rem\">'+\n'<input id=\"cwho\" placeholder=\"you\" size=\"10\">'+\n");
  http.add("'<input id=\"ctext\" placeholder=\"say something\" style=\"flex:1\">'+\n'<label class=\"chk\"><input type=\"checkbox\" id=\"cag\"> for agents</label>'+\n");
  http.add("'<button onclick=\"addcomment()\">Comment</button></div>';\nreturn h}\n\nasync function addlog(){const v=$('logtext').value.trim();if(!v||!cur)return;\n");
  http.add("await api('log_work',{id:cur.id,text:v,audience:$('logag').checked?'agent':'human'});await load();\n");
  http.add("open_(all.find(t=>t.id===cur.id))}\n\nasync function addcomment(){const v=$('ctext').value.trim();if(!v||!cur)return;\n");
  http.add("const who=$('cwho').value.trim()||'someone';\nawait api('add_comment',{id:cur.id,author:who,text:v,\n");
  http.add("audience:$('cag').checked?'agent':'human'});await load();\nopen_(all.find(t=>t.id===cur.id))}\n");
  http.add("\nfunction close_(){$('sheet').classList.remove('on');cur=null;\nif(location.hash)history.pushState({},'',location.pathname)}\n");
  http.add("\n// Opening from the address bar: on first load, and on back/forward.\nfunction fromhash(){\nconst id=location.hash.slice(1);\n");
  http.add("if(!id){if(cur){$('sheet').classList.remove('on');cur=null}return}\nconst t=all.find(x=>x.id===id);\n");
  http.add("if(t&&t!==cur)open_(t)}\naddEventListener('popstate',fromhash);\n\nfunction fields(){const L=$('f_labels').value.split(',').map(s=>s.trim()).filter(Boolean);\n");
  http.add("const o={title:$('f_title').value.trim(),body:$('f_body').value,\npriority:$('f_priority').value,area:$('f_area').value.trim()||'general',labels:L};\n");
  http.add("o.kind=$('f_kind').value||null;\no.flow=$('f_flow').value||null;\no.milestone=$('f_milestone').value.trim()||null;\n");
  http.add("o.assignee=$('f_assignee').value.trim()||null;return o}\n\nasync function save(){const f=fields();\n");
  http.add("if(!f.title){alert('A ticket needs a title.');return}\nif(cur){f.id=cur.id;f.status=$('f_status').value;await api('update_ticket',f)}\n");
  http.add("else{const c={...f};delete c.status;await api('create_ticket',c)}\nclose_();await load()}\n\nasync function del(){if(!cur||!confirm('Delete '+cur.id+'?'))return;\n");
  http.add("await api('delete_ticket',{id:cur.id});close_();await load()}\n\nfor(const i of ['q','fm','fa','fp','fk','ff'])$(i).addEventListener('input',draw);\n");
  http.add("document.addEventListener('keydown',e=>{if(e.key==='Escape')close_()});\nsetagent(showagent);\n");
  http.add("load().then(fromhash);\n");
end;

procedure asset.docscss;
begin
  http.add("/* The API reference. Same tokens as the board -- it is the same product, one door over. */\n");
  http.add("main{max-width:52rem;margin:0 auto;padding:1.4rem 1.1rem 4rem}\n.lnk{color:var(--accent);text-decoration:none;font-size:.9rem;font-weight:600}\n");
  http.add(".lnk:hover{text-decoration:underline}\n.tool{border-top:1px solid var(--rule);padding:1.8rem 0 .4rem}\n");
  http.add(".tool:first-child{border-top:0}\n.tool h2{font:600 1.05rem/1.3 ui-monospace,Menlo,monospace;margin:0 0 .4rem;\n");
  http.add("         letter-spacing:-.01em;word-break:break-word}\n.verb{display:inline-block;background:var(--accent);color:var(--bg);border-radius:6px;\n");
  http.add("      padding:.05rem .4rem;font-size:.72rem;letter-spacing:.06em;margin-right:.45rem;\n      vertical-align:.12em}\n");
  http.add(".tool h3{font:550 .78rem/1 inherit;letter-spacing:.055em;text-transform:uppercase;\n         color:var(--muted);margin:1.3rem 0 .5rem}\n");
  http.add(".lead{margin:0 0 .3rem;color:var(--fg)}\n.tool table{width:100%;border-collapse:collapse;font-size:.9rem}\n");
  http.add(".tool th{text-align:left;font:550 .74rem/1 inherit;letter-spacing:.05em;\n         text-transform:uppercase;color:var(--muted);padding:.35rem .5rem .35rem 0;\n");
  http.add("         border-bottom:1px solid var(--rule)}\n.tool td{padding:.45rem .5rem .45rem 0;border-bottom:1px solid var(--rule);\n");
  http.add("         vertical-align:top}\ntd.k{font:600 .86rem ui-monospace,Menlo,monospace;white-space:nowrap}\n");
  http.add("td.ty{font:.82rem ui-monospace,Menlo,monospace;color:var(--accent);white-space:nowrap}\ntd.ds{color:var(--muted)}\n");
  http.add(".lim{color:var(--muted);font-weight:400}\n.req{display:inline-block;background:var(--soft);color:var(--accent);border-radius:999px;\n");
  http.add("     padding:0 .4rem;font:600 .66rem/1.5 ui-sans-serif,system-ui,sans-serif;\n     margin-left:.4rem;vertical-align:.08em;text-transform:uppercase;letter-spacing:.05em}\n");
  http.add(".tool pre{background:var(--soft);border:1px solid var(--rule);border-radius:10px;\n          padding:.8rem .9rem;overflow-x:auto;margin:0;\n");
  http.add("          font:.8rem/1.6 ui-monospace,Menlo,monospace}\n.also{color:var(--muted);font-size:.86rem;margin:1rem 0 0}\n");
  http.add("@media(max-width:620px){\n  main{padding:1rem .8rem 3rem}\n  td.k,td.ty{white-space:normal}\n}\n");
  http.add("");
end;

procedure asset.docshtml;
begin
  http.add("<header>\n<h1>wantzel-tasks</h1>\n<span class=\"sub\">the API, generated from <code>schema.wz</code></span>\n");
  http.add("<span class=\"grow\"></span>\n<a class=\"lnk\" href=\"/\">the board</a>\n<a class=\"lnk\" href=\"/tools.json\">tools.json</a>\n");
  http.add("</header>\n<div class=\"bar\">\n<div class=\"scroll\"><input id=\"q\" placeholder=\"filter tools\"></div>\n");
  http.add("<span class=\"sub\" id=\"count\"></span>\n</div>\n<main id=\"tools\"><p class=\"empty\">loading the tool table…</p></main>\n");
  http.add("");
end;

procedure asset.docsjs;
begin
  http.add("// The API reference renders itself from /tools.json, which the compiler generated from\n// schema.wz. Nothing here restates a field name: a page that repeats a declaration by\n");
  http.add("// hand is a page that goes stale on the first change.\nconst $ = i => document.getElementById(i);\n");
  http.add("const esc = s => (s || '').replace(/[&<>\"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]));\n");
  http.add("let TOOLS = [];\n\n// One property as a row: its name, its type, whether it is required, and the description\n");
  http.add("// the schema carries. `required` lives on the parent, so it is passed in.\nfunction prop(name, p, required) {\n");
  http.add("  const t = p.type === 'array' ? (p.items?.type || 'any') + '[]' : (p.type || 'any');\n  const lim = p.maxLength ? ' &le;' + p.maxLength : (p.maxItems ? ' &le;' + p.maxItems : '');\n");
  http.add("  return '<tr><td class=\"k\">' + esc(name) + (required ? '<span class=\"req\">required</span>' : '') +\n");
  http.add("         '</td><td class=\"ty\">' + esc(t) + '<span class=\"lim\">' + lim + '</span></td>' +\n         '<td class=\"ds\">' + esc(p.description || '') + '</td></tr>';\n");
  http.add("}\n\nfunction table(schema, empty) {\n  const props = schema?.properties || {};\n  const keys = Object.keys(props);\n");
  http.add("  if (!keys.length) return '<p class=\"empty\">' + empty + '</p>';\n  const req = schema.required || [];\n");
  http.add("  return '<table><thead><tr><th>field</th><th>type</th><th>meaning</th></tr></thead><tbody>' +\n");
  http.add("         keys.map(k => prop(k, props[k], req.includes(k))).join('') + '</tbody></table>';\n}\n");
  http.add("\n// A body a reader can paste into curl, built from the schema's own required fields.\nfunction example(t) {\n");
  http.add("  const props = t.inputSchema?.properties || {};\n  const req = t.inputSchema?.required || Object.keys(props).slice(0, 1);\n");
  http.add("  const body = {};\n  for (const k of req) {\n    const p = props[k] || {};\n    body[k] = p.type === 'array' ? [] : (k === 'id' ? 'T-0001' : (p.description || k).split(',')[0].slice(0, 28));\n");
  http.add("  }\n  return \"curl -X POST http://127.0.0.1:7777/api/\" + t.name + \" \\\\\\n\" +\n         \"  -H 'Content-Type: application/json' \\\\\\n\" +\n");
  http.add("         \"  -d '\" + JSON.stringify(body) + \"'\";\n}\n\nfunction draw() {\n  const f = $('q').value.trim().toLowerCase();\n");
  http.add("  const show = TOOLS.filter(t => !f || t.name.includes(f) || (t.description || '').toLowerCase().includes(f));\n");
  http.add("  $('count').textContent = show.length + ' of ' + TOOLS.length + ' tools';\n  $('tools').innerHTML = show.map(t =>\n");
  http.add("    '<section class=\"tool\" id=\"' + esc(t.name) + '\">' +\n      '<h2><span class=\"verb\">POST</span> /api/' + esc(t.name) + '</h2>' +\n");
  http.add("      '<p class=\"lead\">' + esc(t.description || '') + '</p>' +\n      '<h3>Arguments</h3>' + table(t.inputSchema, 'takes no arguments') +\n");
  http.add("      '<h3>Returns</h3>' + table(t.outputSchema, 'returns nothing') +\n      '<h3>Try it</h3><pre>' + esc(example(t)) + '</pre>' +\n");
  http.add("      '<p class=\"also\">The same tool over MCP: <code>' + esc(t.name) + '</code> at ' +\n      '<code>POST /mcp</code>, and from the board.</p>' +\n");
  http.add("    '</section>').join('') || '<p class=\"empty\">nothing matches</p>';\n}\n\n(async () => {\n  const r = await fetch('/tools.json');\n");
  http.add("  TOOLS = (await r.json()).tools;\n  draw();\n  $('q').addEventListener('input', draw);\n  if (location.hash) document.getElementById(location.hash.slice(1))?.scrollIntoView();\n");
  http.add("})();\n");
end;

