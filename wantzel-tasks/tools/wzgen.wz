// wzgen -- turn web/app.css, web/app.html and web/app.js into Wantzel source.
//
// WHY THIS EXISTS. The frontend should be written in the languages it is written in: a
// .css file an editor highlights, an .html file you can read. But the promise of this
// project is ONE binary that depends on nothing -- so the files cannot be read at run
// time, or the binary stops working the moment it is moved without its directory.
//
// So they are read at BUILD time and compiled in. This generator is the step between:
//
//     web/app.css  ->
//     web/app.html ->   wzgen   ->   src/assets.wz   ->   linked into the binary
//     web/app.js   ->
//
// It is written in Wantzel because tooling in a Wantzel project is written in Wantzel.
// That is not symbolism: it is the same requirement as "no external dependencies", and
// it is evidence the language handles real work.

include "io.wz";
include "fs.wz";

const
  MAXFILE = 262144;         // one asset; the largest today is app.js at ~6 kB
  MAXOUT  = 1048576;        // the generated source, which is bigger than its input
  LINELEN = 92;             // where a generated string is broken, to keep it readable

var
  buf:  array[0..MAXFILE - 1] of char;
  bufn: int;
  out:  array[0..MAXOUT - 1] of char;
  outn: int;
  path: array[0..255] of char;

// Read one file whole. A partial read would produce a binary that serves half a page,
// so anything short of the whole file is a failure rather than a truncation.
function slurp(name: str): bool;
var fd, got, n: int;
begin
  n := 0;
  n := io.push(path, 0, name);
  path[n] := chr(0);
  fd := fs.open(addr(path[0]));
  if fd < 0 then return false;
  got := io.read(fd, addr(buf[0]), MAXFILE);
  fs.close(fd);
  if got <= 0 then return false;
  bufn := got;
  return true;
end;

procedure emit(s: str);
begin
  outn := io.push(out, outn, s);
end;

// One character of the asset, escaped for a Wantzel string literal. Only two characters
// need it -- the quote and the backslash -- and a newline becomes \n rather than a real
// line break, because a string literal may not span lines.
procedure emitch(c: char);
begin
  if c = '"' then begin emit("\\\""); return; end;
  if c = '\\' then begin emit("\\\\"); return; end;
  if c = chr(10) then begin emit("\\n"); return; end;
  if c = chr(13) then return;                      // CRLF in, LF out
  out[outn] := c; outn := outn + 1;
end;

// Write the asset as a procedure that pushes it onto the response. Broken into lines of
// about LINELEN so the generated file can be opened and read -- a single 6 kB line is
// technically fine and practically unreadable, and this file goes in the repository.
procedure emitasset(name: str);
var i, col: int;
begin
  emit("procedure "); emit(name); emit(";\n");
  emit("begin\n");
  emit("  http.add(\"");
  col := 0;
  i := 0;
  while i < bufn do
  begin
    emitch(buf[i]);
    col := col + 1;
    // Break only after a newline, so a line of the generated source holds a whole line of
    // the asset. Breaking mid-token would still compile and would be unreadable.
    if (col >= LINELEN) and (buf[i] = chr(10)) then
    begin
      emit("\");\n  http.add(\"");
      col := 0;
    end;
    i := i + 1;
  end;
  emit("\");\nend;\n\n");
end;

procedure asset(file: str; name: str);
begin
  if not slurp(file) then
  begin
    io.puts(2, "wzgen: cannot read ");
    io.puts(2, file);
    io.puts(2, "\n");
    halt(1);
  end;
  emitasset(name);
end;

var fd, n: int;
begin
  outn := 0;
  emit("// GENERATED by tools/wzgen.wz from web/ -- do not edit.\n");
  emit("//\n");
  emit("// Edit web/app.css, web/app.html or web/app.js and run ./wztrun, which\n");
  emit("// regenerates this file. It is committed so that the repository builds with\n");
  emit("// nothing but the compiler.\n\n");

  asset("web/app.css",  "asset.css");
  asset("web/app.html", "asset.html");
  asset("web/app.js",   "asset.js");

  // The API reference is a second page in the same binary, built from the same tool table
  // the agents call. One product, one build.
  asset("web/docs.css",  "asset.docscss");
  asset("web/docs.html", "asset.docshtml");
  asset("web/docs.js",   "asset.docsjs");

  n := io.push(path, 0, "src/assets.wz");
  path[n] := chr(0);
  fd := sys3(SYS.open, addr(path[0]), bor(bor(O_WRONLY, O_CREAT), O_TRUNC), 420);
  if fd < 0 then begin io.puts(2, "wzgen: cannot write src/assets.wz\n"); halt(1); end;
  if io.write(fd, addr(out[0]), outn) <> outn then
  begin
    io.puts(2, "wzgen: short write\n");
    halt(1);
  end;
  sys1(SYS.close, fd);

  io.puts(1, "wzgen: src/assets.wz written\n");
end.
